Actor Flare_General
{
Scale 0.4
radius 6
height 12
alpha 0.4
renderstyle Add
+NOINTERACTION
+NOGRAVITY
+CLIENTSIDEONLY
+NOCLIP
}

Actor RedFlare : Flare_General
{
	states
	{
	Spawn:
		LENR A 0 NoDelay A_Jump(128,2)
		LENR A 2 Bright
		Stop
		LENR B 2 Bright
		Stop
	}
}

