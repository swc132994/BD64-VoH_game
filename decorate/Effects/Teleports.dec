ACTOR TeleportationFog : TeleportFog Replaces TeleportFog
{
Scale 1.25
Radius 1
Height 1
Mass 0
Renderstyle Add
+NOBLOCKMAP
+NOINTERACTION
+NOCLIP
	States
	{
	Spawn:
		TNT1 A 0 NoDelay Radius_Quake(3,3,0,10,0)
		TNT1 A 0 A_PlaySound("misc/teleport",CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("PentagramSpawner")
		TPFG HGFEDCBA 1 Bright
		TNT1 A 0 A_CheckSight("QuietDeath")
		TNT1 AAAAAA 0 A_SpawnItemEx("ExplosionParticleGreenHeavySmall",0,0,30,frandom(-6,6),frandom(-6,6),frandom(2,6),random(0,360),SXF_CLIENTSIDE,51)
		TNT1 AAAAAA 0 A_SpawnItemEx("ExplosionParticleGreenVeryFast",0,0,30,frandom(-10,10),frandom(-10,10),frandom(3,8),random(0,360),SXF_CLIENTSIDE,51)
	QuietDeath:
		TPFG ABCDEFG 1 Bright
		Stop
	Death:
		TNT1 A 1
		Stop
	}
}

ACTOR PentagramSpawner
{
XScale 0.25
YScale 0.025
Gravity 10
Radius 1
Height 1
Alpha 1
RenderStyle Add
+NOBLOCKMAP
+THRUACTORS
+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_SpawnItemEx("BurningPentagram")
		TNT1 A 35
		TNT1 A 1 A_SpawnItemEx("PentagramOff")
		Stop
	}
}

ACTOR BurningPentagram : PentagramSpawner	//modelled
{
Alpha 0
	States
	{
	Spawn:
		PNTG AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright Light("BETABALL_X4") NoDelay A_FadeIn(0.03)
		PNTG A 1 Bright A_FadeOut(0.03)
		Wait
	}
}

ACTOR PentagramOff : PentagramSpawner 	//modelled
{
Renderstyle Normal
	States
	{
	Spawn:
		PNTG B 2 A_FadeOut(0.01)
		Wait
	}
}