		delay(4);
		setfont("RBLD6");  hudmessage(s:"A"; HUDMSG_PLAIN,id,CR_UNTRANSLATED,63.1,61.1,0.15);
		delay(4);
		setfont("RBLD7");  hudmessage(s:"A"; HUDMSG_PLAIN,id,CR_UNTRANSLATED,63.9,61.9,0.15);
		delay(4);
		setfont("RBLD8");  hudmessage(s:"A"; HUDMSG_PLAIN,id,CR_UNTRANSLATED,63.9,61.9,0.15);
		delay(4);
