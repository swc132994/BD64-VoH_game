//********** Splashes **********
ACTOR GiantWaterRicochet : RicoChet	//Ricochet found in puffs file
{
XScale 3.0
YScale 2.0
alpha 0.9
renderstyle Add
+NOBLOCKMAP
+THRUACTORS
+NOGRAVITY
+CLIENTSIDEONLY
	states
	{
	Spawn:
		GSPL ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
		Stop
	}
}

actor WaterSplashBase2
{
Scale 1.1
Radius 1
Height 1
Mass 0x7FFFFFFF
Health 100
alpha 0.6
DamageFactor "CauseWaterSplash",99.0
DamageType "CauseObjectsToSplash"
+DONTSPLASH
+NOGRAVITY
+THRUACTORS
+SHOOTABLE
+NOBLOOD
+BLOODLESSIMPACT
+NODAMAGETHRUST
	States
	{
	Spawn:
		TNT1 A 3 NoDelay ACS_NamedExecuteAlways("LiquidSplashCvarACS")
		TNT1 AAAAAA 0 A_SpawnItemEx("WaterParticleX",random(-5,5),random(-5,5),2,frandom(-2,2),frandom(-2,2),frandom(2,5))
		TNT1 AAAAAA 0 A_SpawnItemEx("WaterParticleXFaster",random(-5,5),random(-5,5),2,frandom(-3,3),frandom(-3,3),frandom(3,7))
		TNT1 A 0 A_Explode(2,6)
		TNT1 AA 6
		TNT1 A 0 A_UnSetShootable
		TNT1 AA 6
		Stop
	Death.CauseWaterSplash:
		TNT1 A 0 A_SpawnItemEx("WaterParticleXSpawner",0,0,0,frandom(-3,3),frandom(-3,3),frandom(4,8))
		TNT1 A 0 A_SpawnItemEx("GiantWaterRicochet")
		TNT1 A 0 A_PlaySound("bigspl1",CHAN_BODY)
		TNT1 A 30
		Stop
	NoSplash:
		TNT1 A 1
		Stop
	}
}

actor LiquidExplosionEffectSpawner
{
Radius 2
Height 2
DamageType "CauseWaterSplash"
+NOBLOCKMAP
+THRUACTORS
+DONTSPLASH
+MISSILE
+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 3 NoDelay ACS_NamedExecuteAlways("LiquidSplashCvarACS")
		TNT1 A 1 A_Explode(3,9)
		Stop
	NoSplash:
		TNT1 A 1
		Stop
	}
}

