//		TNT1 A 0 A_Jumpif(args[0] == 4,"Hordex3")
//		TNT1 A 0 A_Jumpif(args[0] == 5,"Hordex4")
		TNT1 A 0 A_JumpIf(CallACS("HordeMultiplierACS") == -1,"Disabled")
		TNT1 A 0 A_JumpIf(CallACS("HordeMultiplierACS") == 1,"Hordex1")
		TNT1 A 0 A_JumpIf(CallACS("HordeMultiplierACS") == 2,"Hordex2")
		TNT1 A 0 A_JumpIf(CallACS("HordeMultiplierACS") == 3,"Hordex3")
		TNT1 A 0 A_JumpIf(CallACS("HordeMultiplierACS") == 4,"Hordex4")
		TNT1 A 0 A_Jump(CallACS("MonstersSpawnPercentACS",18)*13,"Hordex1","Hordex2","Hordex3","Hordex4")
	Disabled:
		TNT1 A 1
		Stop
	Hordex1:
		TNT1 A 1 A_SpawnItemex("64HuskZombie",0,0,0,0,0,0,0,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Stop
	Hordex2:
		TNT1 A 0 A_SpawnItemex("64HuskZombie",-20,0,0,0,0,0,0,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 1 A_SpawnItemex("64HuskZombie",20,0,0,0,0,0,180,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Stop
	Hordex3:
		TNT1 A 0 A_SpawnItemex("64HuskZombie",-20,0,0,0,0,0,0,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 0 A_SpawnItemex("64HuskZombie",0,20,0,0,0,0,270,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 1 A_SpawnItemex("64Carrion",0,-20,0,0,0,0,90,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		stop
	Hordex4:
		TNT1 A 0 A_SpawnItemex("64HuskZombie",-20,0,0,0,0,0,0,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 0 A_SpawnItemex("64HuskZombie",0,20,0,0,0,0,270,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 0 A_SpawnItemex("64HuskZombie",20,0,0,0,0,0,180,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		TNT1 A 1 A_SpawnItemex("64Carrion",0,-20,0,0,0,0,90,SXF_ABSOLUTEANGLE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Stop
	}
}

//Direct monster replacers
Actor BD64WolfensteinSSReplacer Replaces WolfensteinSS
{
//$Category Monsters
//$Title "Wolf SS Spawner"
//$Arg0 What monster to spawn
//$Arg0Tooltip Select the monster to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Wolf SS"; 2 = "Force Zombie Marine"; 3 = "Force Motherdemon"; 4 = "Force Forgotten One"; }
Scale 0.7
MONSTER
-SOLID
-COUNTKILL
+NOTARGET
+NOBLOOD
	States
	{
	Death:
	XDeath:
		TNT1 A 35
		TNT1 A 1 A_BossDeath
		Stop
	Spawn:
		CPOS A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"Doom2")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"Doom64")
//		TNT1 A 0 A_Jumpif(args[0] == 3,"GoingDown")
//		TNT1 A 0 A_Jumpif(args[0] == 4,"DoomZero")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 1,"Doom2")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 2,"Doom64")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 3,"ScytheII")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 4,"BloodStain")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 5,"GoingDown")
		TNT1 A 0 A_JumpIf(CallACS("WadCheckerACS") == 6,"DoomZero")
		Goto Doom64
	Doom2:
		TNT1 A 1 A_SpawnItemEx("64WaffenSS",0,0,0,0,0,0,0,SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	Doom64:
	ScytheII:
	BloodStain:
		TNT1 A 1 A_SpawnItemEx("64ZombieMarine",0,0,0,0,0,0,0,SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	GoingDown:
		TNT1 A -1 A_SpawnItemEx("Motherdemon_GD",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	DoomZero:
		TNT1 A 1 A_SpawnItemEx("64ForgottenOne",0,0,0,0,0,0,0,SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

