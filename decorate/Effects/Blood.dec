actor GrowingBloodPool : Brutal_BloodSpot	//modelled
{
Scale 0.5
	states
	{
	Death:
		TNT1 A 0 A_SetAngle(random(0,360))
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_ChangeFlag("MISSILE",FALSE)
		FBB1 A 30
		FBB1 BCDEFGHIJKLMNOPQRSTUVWXYZ 3
	Rest:
		FBB1 Z 900
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Fade")
		loop
	Fade:
		FBB1 Z 3 A_FadeOut(0.1)
		Wait
	Splash:
		TNT1 A 1
		stop
	}
}

