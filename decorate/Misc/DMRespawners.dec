//WEAPON RESPAWNERS
Actor ChainsawRespawnerDM
{
+NOINTERACTION
+NOGRAVITY
+MOVEWITHSECTOR
	States
	{
	Spawn:
		TNT1 A 6
		TNT1 A 0 A_JumpIfCloser(64,"Spawn")
		TNT1 A 0 A_JumpIf(CallACS("DM_SpawnACS") == 1,"DMRespawnTimer")
		Stop

	DMRespawnTimer:
		TNT1 A 1050
		TNT1 A 0 A_SpawnItemEx("TeleportationFogObject")
		TNT1 A 1 A_SpawnItemEx("Chainsaw",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION)
		Stop
	}
}

