Actor Hound_Chooser	19125	//Used for direct hound placement on maps. Tag 666 fix (A_KillMaster must be called from spawned monster)
{
//$category "Game/BD64_Monsters"
SpawnID 185
Scale 0.8
MONSTER
-SOLID
-COUNTKILL
+BOSSDEATH
+NOTARGET
+NOBLOOD
	States
	{
	Death:
	XDeath:
		TNT1 A 35
		TNT1 A 0 A_BossDeath
		TNT1 A 1 A_KillMaster("None")	//tag 666 fix
		Stop
	Spawn:
		GECH A 0
		TNT1 A 0 A_JumpIf(CallACS("HoundChooserACS") == -1,"D64MonsterOnly")
		TNT1 A 0 A_JumpIf(CallACS("HoundChooserACS") == 0,"HoundDefault")
		TNT1 A 0 A_JumpIf(CallACS("HoundChooserACS") == 1,"HoundGEC")
		TNT1 A 0 A_Jump(256,"HoundDefault","HoundGEC")
	HoundDefault:
		TNT1 A -1 A_SpawnItemEx("64Hellhound",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	HoundGEC:
		TNT1 A -1 A_SpawnItemEx("64HellHoundGEC",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	D64MonsterOnly:
		TNT1 A -1 A_SpawnItemEx("64Spectre",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

//Anomaly Events
//Prop replacements
Actor 64DemonicTreeReplacer replaces BigTree
{
//$Category Obstacles
//$Title "Large Brown Tree Spawner"
//$Arg0 What obstacle to spawn
//$Arg0Tooltip Select the obstacle to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Large brown tree"; 2 = "Force Large demonic tree"; }
Scale 0.7
Radius 32
Height 108
ProjectilePassHeight -16
+SOLID
	States
	{
	Spawn:
		LTRI A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnBigTree")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnDemonTree")
		TNT1 A 0 A_JumpIf(CallACS("PoltergeistEnablerACS") == 0,"SpawnBigTree")
		TNT1 A 0 A_Jump(26,"SpawnDemonTree")//10%
	SpawnBigTree:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_SetScale(0-ScaleX,ScaleY)	//flip horzizontal
		TNT1 A 0 A_Jump(256,1,2,3,4)
		LTRI A -1
		stop
		LTRI B -1
		Stop
		LTRI C -1
		stop
		TNT1 A 0 A_SpawnItemEx("64SmallBloodPool")
		TNT1 A 0 A_SpawnItemEx("Swarm",0,0,15)
		LTRI D -1
		Stop
	SpawnDemonTree:
		TNT1 A 0 A_UnsetSolid
		TNT1 A -1 A_SpawnItemEx("64PossessedTree",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor 64EvilEyeReplacer replaces EvilEye
{
//$Category Obstacles
//$Title "Evil Eye Spawner"
//$Arg0 What obstacle to spawn
//$Arg0Tooltip Select the obstacle to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Evil Eye"; 2 = "Force Venom Eye 1"; 3 = "Force Venom Eye 2"; }
Scale 0.7
Radius 16
Height 54
ProjectilePassHeight -16
+SOLID
	states
	{
	Spawn:
		CEYE A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnEvilEye")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnVenomEye1")
//		TNT1 A 0 A_Jumpif(args[0] == 3,"SpawnVenomEye2")
		TNT1 A 0 A_JumpIf(CallACS("PoltergeistEnablerACS") == 0,"SpawnEvilEye")
		TNT1 A 0 A_Jump(26,"SpawnVenomEye1","SpawnVenomEye2")//10%
		Goto SpawnEvileye
	SpawnEvilEye:
		TNT1 A 0 A_SpawnItemEx("LightShaft2BrighterLess",0,0,20)
		TNT1 A 0 A_Jump(128,"EvilEyeStay2")
		Goto EvilEyeStay
	EvilEyeStay:
		CEYE ABCB 5 Bright Light("GreenCANDLETORCH")
		Loop
	EvilEyeStay2:
		EYE2 ABCB 5 Bright Light("GreenCANDLETORCH")
		Loop
	SpawnVenomEye1:
		TNT1 A 0 A_UnsetSolid
		TNT1 A 0 A_SpawnItemEx("64VenomCandle",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A -1 A_SpawnItemEx("64VenomEye1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	SpawnVenomEye2:
		TNT1 A 0 A_UnsetSolid
		TNT1 A 0 A_SpawnItemEx("64VenomCandle",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A -1 A_SpawnItemEx("64VenomEye2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor 64CandlestickReplacer replaces Candlestick
{
//$Category Light sources
//$Title "Candle Spawner"
//$Arg0 What light source to spawn
//$Arg0Tooltip Select the light source to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Candle"; 2 = "Force Hell Candle"; }
Scale 0.7
Radius 20
Height 14
ProjectilePassHeight -16
	States
	{
	Spawn:
		CAND A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnCandlestick")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnHellCandle")
		TNT1 A 0 A_JumpIf(CallACS("PoltergeistEnablerACS") == 0,"SpawnCandlestick")
		TNT1 A 0 A_Jump(26,"SpawnHellCandle")//10%
	SpawnCandlestick:
		TNT1 A 0 A_JumpIf(CallACS("ClassicTorchACS") == 1,"ClassicTorch")
		TNT1 A 0 A_SpawnItemEx("LightShaft2BrighterLessSmall")
	Stay:
		TNT1 A 0 A_CheckSight("StayBlank")
		TNT1 A 0 A_SpawnItemEx("LensFlareAltLongOrangeCandle",0,0,20)
		CAND ABABABABABABABABAB 2 Light("CANDLETORCH")
		Loop
	StayBlank:
		CAND ABABABABABABABABAB 2 Light("CANDLETORCH")
		Goto Stay
	ClassicTorch:
		CAND ABAB 2 Light("CANDLETORCH")
		Loop
	SpawnHellCandle:
		TNT1 A -1 A_SpawnItemEx("64Poltergeist1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor 64CandelabraGhostReplacer replaces Candelabra
{
//$Category Light sources
//$Title "Candelabra Spawner"
//$Arg0 What light source to spawn
//$Arg0Tooltip Select the light source to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Candelabra"; 2 = "Force Hell Candelabra"; }
Scale 0.7
Radius 16
Height 60
ProjectilePassHeight -16
+SOLID
	States
	{
	Spawn:
		64CN A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnCandelabra")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnHellCandle")
		TNT1 A 0 A_JumpIf(CallACS("PoltergeistEnablerACS") == 0,"SpawnCandelabra")
		TNT1 A 0 A_Jump(26,"SpawnHellCandle")//10%
	SpawnCandelabra:
		TNT1 A 0 A_JumpIf(CallACS("ClassicTorchACS") == 1,"ClassicTorch")
		TNT1 A 0 A_SpawnItemEx("LightShaft2Fast",0,0,45)
		TNT1 A 0 A_SpawnItemEx("LensFlareTorchOrangeLoop",0,0,45)
		TNT1 A 0 A_SpawnItemEx("TorchBallRedLoop",0,0,45)		
		TNT1 A 0 A_Playsound("props/redfire",CHAN_BODY,1,TRUE,2.25)
	Stay:
		TNT1 A 0 A_CheckSight("StayBlank")
		64CN ABABABABABAB 3 Light("SMALLREDTORCH") A_CustomMissile("RealFlameTrailsWallTorch",45,0,random(0,360),2,random(70,110))
		Loop
	StayBlank:
		CBRA ABCDEABCDEABCDE 2 Light("SMALLREDTORCH")
		Goto Stay
	ClassicTorch:
		CBRA ABCDE 4 Light("SMALLREDTORCH")
		Loop
	SpawnHellCandle:
		TNT1 A 0 A_UnsetSolid
		TNT1 A -1 A_SpawnItemEx("64Poltergeist3",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

