Actor 64ClipBoxReplacer : CustomInventory Replaces Clipbox
{
Scale 0.82
	States
	{
	Spawn:
		AMMO A 0
		TNT1 A 0 A_Jump(64,"SpawnBoth")
		TNT1 A 0 A_Jump(128,"SpawnHighCalibreBox")
	SpawnClipBox:
		TNT1 A 1 A_SpawnItemEx("64ClipBox",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnHighCalibreBox:
		TNT1 A 1 A_SpawnItemEx("64HighCaliberBox",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnBoth:
		TNT1 A 0 A_SpawnItemEx("64ClipBox",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		TNT1 A 1 A_SpawnItemEx("64HighCaliberBox",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL)
		Stop
	}
}

Actor 64ClipBox : ClipBox
{
Scale 0.82
Inventory.PickupMessage "$FO_GOTCLIPBOX"
Inventory.PickupSound "IPICK"
Tag "$FO_TAG_CLIPBOX"
	States
	{
	Spawn:
		AMMO A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AltAmmoSpritesACS") == 2,"AlternativeSprite")
	ShowNormal:
		AMMO A -1
		Stop
	AlternativeSprite:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt")
	SpawnAlt:
		AMO2 A -1
		Stop
	}
}

Actor 64HighCaliberBox : Ammo	//new ammo for rifle and chaingun
{
Scale 0.82
Inventory.PickupSound "IPICK"
Inventory.PickupMessage "$FO_GOTCLIPBOX2"
Inventory.Amount 50
Inventory.MaxAmount 200
Ammo.BackpackAmount 10
Ammo.BackpackMaxAmount 400
Inventory.Icon "HI04X0"
Tag "$FO_TAG_CLIPBOX2"
	States
	{
	Spawn:
		HI04 X -1
		Stop
	}
}

Actor 64ShellBox : ShellBox Replaces ShellBox
{
Scale 0.82
Inventory.Amount 16
Inventory.PickupMessage "$FO_GOTSHELLBOX"
Inventory.PickupSound "IPICK"
Tag "$FO_TAG_SHELLBOX"
	States
	{
	Spawn:
		SBOX A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1 && CallACS("AltAmmoSpritesACS") == 2,"SpawnAny")
		TNT1 A 0 A_JumpIf(CallACS("AltAmmoSpritesACS") == 2,"AlternativeSprite")
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1,"ShowAlpha")
	ShowNormal:
		SBOX A -1
		Stop
	AlternativeSprite:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt")
	SpawnAny:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt","ShowAlpha")
	SpawnAlt:
		SBX2 A -1
		Stop
	ShowAlpha:
		SBOX B -1
		Stop
	}
}

ACTOR 64Rocketbox : Rocketbox Replaces Rocketbox
{
Scale 0.82
Inventory.PickupMessage "$FO_GOTROCKBOX"
Inventory.PickupSound "IPICK"
Tag "$FO_TAG_ROCKBOX"
	States
	{
	Spawn:
		BROK A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AltAmmoSpritesACS") == 2,"AlternativeSprite")
	ShowNormal:
		BROK A -1
		Stop
	AlternativeSprite:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt")
	SpawnAlt:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_SetScale(0-ScaleX,ScaleY)
		RBX2 A -1
		Stop
	}
}

Actor 64CellPack : CellPack Replaces CellPack
{
Scale 0.82
Inventory.PickupMessage "$FO_GOTCELLBOX"
Inventory.PickupSound "IPICK"
Tag "$FO_TAG_CELLBOX"
	States
	{
	Spawn:
		CELP A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1 && CallACS("AltAmmoSpritesACS") == 2,"SpawnAny")
		TNT1 A 0 A_JumpIf(CallACS("AltAmmoSpritesACS") == 2,"AlternativeSprite")
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1,"ShowAlpha")
	ShowNormal:
		CELP A -1
		Stop
	AlternativeSprite:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt","SpawnAlt2")
	SpawnAny:
		TNT1 A 0 A_Jump(256,"ShowNormal","SpawnAlt","SpawnAlt2","ShowAlpha")
	SpawnAlt:
		CPK2 A -1
		Stop
	SpawnAlt2:
		CPK3 ABC 3
		Loop
	ShowAlpha:
		CPKA A -1
		Stop
	}
}

