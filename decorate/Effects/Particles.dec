ACTOR BurnParticlesNoDamage
{
+NOBLOCKMAP
+NOGRAVITY
+CLIENTSIDEONLY
+DONTSPLASH
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(waterlevel > 1,"Splash")
		TNT1 A 0 A_SpawnItemEx("RedFlare",0,0,5,0,0,0,0,SXF_CLIENTSIDE)
		TNT1 A 0 A_SpawnItemEx("PlasmaSmoke",0,0,20,frandom(-1,1),frandom(-1,1),frandom(0.5,1.5),random(0,360),SXF_CLIENTSIDE)
		TNT1 A 1 A_SpawnItemEx("FlameTrails",0,0,0,frandom(-1,1),frandom(-1,1),frandom(0.5,1.5),random(0,360),SXF_CLIENTSIDE)
		Stop
	Splash:
		TNT1 A 1
		Stop
	}
}

ACTOR 64SpawnSpark_Up
{
+NOGRAVITY
+NOCLIP
+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("Sparks/Spawn",CHAN_AUTO)
		TNT1 A 0 A_SpawnItemEx("64SparkFlare_W1",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("64Spark",0,0,0,frandom(-2,2),frandom(-2,2),frandom(1,4),0,SXF_CLIENTSIDE)
		TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
		TNT1 A 140	//4s
		Goto Spawn
		TNT1 A 210	//6s
		Goto Spawn
		TNT1 A 280	//8s
		Goto Spawn
		TNT1 A 350	//10s
		Goto Spawn
		TNT1 A 420	//12s
		Goto Spawn
		TNT1 A 490	//14s
		Goto Spawn
	}
}

ACTOR 64SparkFlare_W1
{
Scale 0.25
RenderStyle Add
+NOCLIP
