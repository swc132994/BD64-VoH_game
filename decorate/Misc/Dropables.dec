//WEAPON DROP SPAWNERS
Actor 64ShotgunDrop
{
Height 2
Radius 2
+NOBLOCKMAP
+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(128,"DropAmmo") //50% Weapon /50% Ammo
		TNT1 A 1 A_SpawnItemEx("DroppedShotgun",0,0,12,frandom(3.0,6.0),0,frandom(2.0,4.0),random(-90,90),SXF_NOCHECKPOSITION)
		Stop
	DropAmmo:
		TNT1 A 1 A_DropItem("64Shell")
		Stop
	}
}

