	States
	{
	Spawn:
		TLMP A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnTechLamp")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnHellLamp")
		TNT1 A 0 A_JumpIf(CallACS("PoltergeistEnablerACS") == 0,"SpawnTechLamp")
		TNT1 A 0 A_Jump(26,"SpawnHellLamp")//10%
	SpawnTechLamp:
		TNT1 A 0 A_SpawnItemEx("LightShaft2")
	StayTechLamp:
		TLMP A 35 Light("BIGLAMP") A_SpawnItemEx("ShortOrangeFlareSmallLamp",0,0,66)
		Loop
	SpawnHellLamp:
		TNT1 A 0 A_UnsetSolid
		TNT1 A -1 A_SpawnItemEx("64Poltergeist7",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

