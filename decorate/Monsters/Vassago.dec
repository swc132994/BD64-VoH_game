ACTOR 64Vassago
{
//$category "Game/BD64_Monsters"
Scale 0.8
Health 1100
Mass 1000
Speed 12
Radius 24
Height 64
MaxStepHeight 40
MaxDropOffHeight 64
MeleeRange 120
PainChance 64
PainChance "Flames",0
PainChance "Bullet",26
PainChance "SuperFists",200
PainChance "Kick",255
PainChance "SuperKick",255
DamageFactor "CauseWaterSplash",0.0
DamageFactor "CauseObjectsToSplash",0.0
DamageFactor "Plasma",0.5
DamageFactor "Flames",0.0
DamageFactor "Ice",2.5
DropItem "DemonEssenceSpawner"
SeeSound "Vassago/SeeSound"
ActiveSound "Vassago/ActiveSound"
PainSound "Vassago/PainSound"
DeathSound "Vassago/DeathSound"
Tag "$FO_TAG_VASSAGO"
Obituary "$FO_OB_VASSAGO"
MONSTER
+NOBLOOD
+DONTHARMCLASS
+MISSILEEVENMORE
+FLOORCLIP
+NEVERFAST
	States
	{
	Spawn:
		VASS A 1
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
	Spawned:
		TNT1 A 0 A_CheckSight("SpawnedBlank")
		TNT1 AA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS A 10 A_LookEx
		TNT1 AA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS B 10 A_LookEx
		Loop
	SpawnedBlank:
		VASS AB 10 A_LookEx
		Goto Spawned
	See:
		TNT1 A 0 A_Jump(39,"SeeFloat")//15%
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS AA 3 A_Chase
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS BB 3 A_Chase
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS CC 3 A_Chase
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS BB 3 A_Chase
		TNT1 A 0 A_JumpIfInTargetInventory("PowerInvisibility",1,"Forget")	
		Loop
	SeeFloat:
		TNT1 A 0 A_ChangeFlag("FLOAT",TRUE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",TRUE)
		TNT1 A 0 A_GiveInventory("VassagoFlightToken",1)
		TNT1 A 0 A_PlaySound("Vassago/ActiveSound",CHAN_AUTO)
		TNT1 A 0 ThrustThingZ(0,15,0,0)
		TNT1 A 0 A_Recoil(-5)
	SeeFloatLoop:
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB AA 3 A_Chase("MissileFloat","MissileFloat")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB BB 3 A_Chase("","")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB CC 3 A_Chase("MissileFloat","MissileFloat")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB AA 3 A_Chase("","")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB BB 3 A_Chase("MissileFloat","MissileFloat")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB CC 3 A_Chase("","")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		TNT1 A 0 A_JumpIfInTargetInventory("PowerInvisibility",1,"Forget")
		TNT1 A 0 A_Jump(128,"SeeFloatLoop")
		Goto SeeLand
	SeeLand:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
	LandingLoop:
		VSSB ABC 3 A_CheckFloor("TouchDown")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		Loop
	TouchDown:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Quake(6,14,0,256,"SUPERFIST")
		VSSB DEFG 2
		Goto See
	Forget:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_ClearTarget
		VASS AB 5 A_Wander
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS CB 5 A_Wander
		VASS A 10 A_LookEx
		TNT1 A 0 A_Jump(33,"Spawn")
		Goto Forget+1
	Melee:
		TNT1 A 0 A_Jump(77,"Melee2")//30%
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_ChangeFlag("NOPAIN",TRUE)
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS DE 4 A_FaceTarget
		TNT1 A 0 A_Recoil(-10)
		TNT1 A 0 ThrustThingZ(0,15,0,0)
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS G 4 A_CustomMeleeAttack(6*random(2,7),"baron/melee")
		VASS H 4 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS EA 4 A_Recoil(4)
		TNT1 A 0 A_ChangeFlag("NOPAIN",FALSE)
		Goto SeeLand
	Melee2:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_Stop
		VSSB A 4 A_FaceTarget
		VSSB BC 4 ThrustThingZ(0,random(30,35),0,0)
		VSSB A 10 A_PlaySound("Vassago/ActiveSound",CHAN_AUTO)
		VSSB A 4 A_FaceTarget
		TNT1 A 0 A_PlaySound("BREATHOF",CHAN_WEAPON)
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(25,30),0,0)
		VSSB A 4 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(20,25),0,0)
		VSSB C 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(15,20),0,0)
		VSSB A 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(10,15),0,0)
		VSSB A 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(5,10),0,0)
		VSSB A 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Recoil(-5)
		VSSB BC 4 ThrustThingZ(0,random(0,5),0,0)
		VSSB A 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		VSSB E 3 A_CustomMissile("64VassagoFlame",53,-21,15,0)
		TNT1 A 0 A_CustomMissile("64VassagoFlame",53,21,-15,0)
		TNT1 A 0 A_SpidRefire
		VSSB A 3 A_FaceTarget
		Goto SeeLand
	Missile:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_Jump(77,"Missile2")//30%
	MissileFloat:
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS E 8 A_PlaySound("Vassago/AttackSound")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS FG 4 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS H 8 A_CustomMissile("64VassagoFireBall")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS R 8 A_PlaySound("Vassago/AttackSound")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS ST 4 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VASS U 8 A_CustomMissile("64VassagoFireBall")
		TNT1 A 0 A_JumpIfInventory("VassagoFlightToken",1,"SeeFloatLoop")
		Goto See
	Missile2:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_Stop
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB A 4 A_PlaySound("Vassago/SeeSound")
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB BC 4 ThrustThingZ(0,random(25,30),0,0)
		TNT1 A 0 A_Recoil(-4)
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB D 8 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		VSSB EF 4 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile("RealFlameTrailsSmall",random(25,40),random(-20,20),random(0,360),2,random(70,110))
		TNT1 A 0 A_Custommissile("64VassagoFire",16,0,-15,0)
		TNT1 A 0 A_Custommissile("64VassagoFire",16,0,0,0)
		VSSB G 2 A_Custommissile("64VassagoFire",16,0,15,0)
		Goto SeeLand
	Pain:
		VASS I 4 A_Pain
		TNT1 A 0 A_JumpIfInventory("VassagoFlightToken",1,"SeeFloatLoop")
		Goto See
	Death:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_KillMaster("None")
		VASS J 6 Bright
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy",30,0,random(0,360),2,random(0,180))
		TNT1 AAAAAA 0 A_CustomMissile("BarrelExplosionFire",30,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleVeryFast",30,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAAA 0 A_CustomMissile("64ExplosionFireBase",30,0,random(0,360),2,random(0,360))
		TNT1 AAAAA 0 A_CustomMissile("ExplosionSmokeFast22",30,0,random(0,360),2,random(0,360))
		VASS K 6 Bright A_Scream
		VASS L 5 Bright
		VASS M 4 Bright A_NoBlocking
		VASS NO 4 Bright
		TNT1 A 0 A_SpawnItemEx("64BarrelExplosion")
		TNT1 A 0 A_SpawnItemEx("DetectFloorCraterMed")
		VASS P 5 Bright// A_BossDeath
		VASS Q -1
		Stop
	Raise:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		VASS PONMLKJ 6
		Goto See
	Crush:
		TNT1 A 0 A_ChangeFlag("FLOAT",FALSE)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE)
		TNT1 A 0 A_TakeInventory("VassagoFlightToken",1)
		TNT1 A 0 A_PlaySound("Misc/Gibbed",CHAN_BODY)
		A038 A -1
		Stop
	Ice:
		"####" "#" 0 A_ChangeFlag("FLOAT",FALSE)
		"####" "#" 0 A_ChangeFlag("NOGRAVITY",FALSE)
		"####" "#" 0 A_TakeInventory("VassagoFlightToken",1)
		"####" "#" 0 A_KillMaster("None")
		"####" "#" 2 ACS_NamedExecuteAlways("IceDeathTranslate")
		"####" "#" 5 A_FreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait
	}
}

Actor VassagoFlightToken : Inventory
{
	Inventory.MaxAmount 1
}

Actor 64VassagoFire
{
Scale 0.72
Height 8
Radius 6
Speed 10
Damage (4)
RenderStyle Translucent
Alpha 0.5
SeeSound "weapons/rocklx" 
DamageType "Flames"
ReactionTime 18
PROJECTILE
+RANDOMIZE
+NODAMAGETHRUST
+FLOORHUGGER
+DONTSPLASH
+RIPPER
+BLOODLESSIMPACT
	States
	{
	Spawn: 
		VFLM EFG 3 Bright A_SpawnItemEx("VassagoFireTrail")
		TNT1 A 0 A_FireCrackle
		TNT1 A 0 A_Countdown
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}

Actor VassagoFireTrail
{
Scale 0.8
Mass 1
Height 8
Radius 6
Speed 0
Damage 0
DamageType "Flames"
Alpha 0.6
RenderStyle Translucent
+NOINTERACTION
+NOBLOCKMAP
+DONTSPLASH
	States
	{
	Spawn:
		MPUF A 5 NoDelay Bright A_SpawnItemEx("LongFlameParticle1")
		TNT1 A 0 A_Explode(6,35,1)
		MPUF A 5 Bright A_SpawnItemEx("LongFlameParticle1")
		TNT1 A 0 A_Explode(6,35,1)
		MPUF A 5 Bright A_SpawnItemEx("LongFlameParticle1")
		TNT1 A 0 A_Explode(6,35,1)
		MPUF A 5 Bright A_SpawnItemEx("LongFlameParticle1")
		TNT1 A 0 A_Explode(6,35,1)
		MPUF A 5 Bright A_SpawnItemEx("LongFlameParticle1")
		TNT1 A 1 A_SpawnItemEx("DetectFloorCraterSmallMotherdemon")
		Stop
	}
}

ACTOR 64VassagoFireBall
{
Scale 1.0
Height 8
Radius 6
Damage 5
Speed 10
FastSpeed 16
RenderStyle Translucent
Alpha 0.75
Decal "MedScorch"
SeeSound "VassagoFlame/SeeSound"
DeathSound "VassagoFlame/BurnSound3"
DamageType "Plasma"
PROJECTILE
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("OldschoolRocketSmokeTrail2")
		TNT1 A 0 A_SpawnItemEx("BaronProjectileCore",0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("LensFlareProjectileRed",0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
		VFLM A 2 Bright
		TNT1 A 0 A_SpawnItemEx("OldschoolRocketSmokeTrail2")
		TNT1 A 0 A_SpawnItemEx("BaronProjectileCore",0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("LensFlareProjectileRed",0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
		VFLM B 2 Bright A_ChangeVelocity(velx*1.2,vely*1.2,velz*1.2,CVF_REPLACE)
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner")
		TNT1 AAAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy",0,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy",0,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAAA 0 A_CustomMissile("ExplosionParticleVeryFast",0,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAAA 0 A_CustomMissile("SmallFireTrail",6,0,0,2,random(-60,80))
		TNT1 AAAAA 0 A_CustomMissile("ExplosionSmokeFast22",0,0,random(0,360),2,random(0,360))
		TNT1 A 0 A_SpawnItemEx("ExplosionAirDisplacementEffect")
		TNT1 A 0 A_PlaySound("EXPLOSIO3",CHAN_VOICE)
		TNT1 A 0 Radius_Quake(2,8,0,12,0)
		TNT1 A 0 A_SpawnItemEx("DetectFloorCraterMed")
		TNT1 A 0 A_SpawnItemEx("DetectCeilCraterMed")
		TNT1 A 0 A_SpawnItemEx("LiquidExplosionEffectSpawner")
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",FALSE) 
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		Goto Burninate
	Burninate:
		VFLM C 2 Bright A_Explode(Random(4,8),64,0)
		VFLM DE 2 Bright
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM F 2 Bright A_Explode(Random(4,8),64,0)
		VFLM GH 2 Bright
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM F 2 Bright A_Explode(Random(4,8),64,0)
		VFLM GH 2 Bright
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM F 2 Bright A_Explode(Random(4,8),64,0)
		VFLM GH 2 Bright
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM F 2 Bright A_Explode(Random(4,8),64,0)
		VFLM GH 2 Bright
		TNT1 A 0 A_SpawnItemEx("DetectFloorCraterMed")
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM F 2 Bright A_Explode(Random(4,8),64,0)
		VFLM GH 2 Bright
		TNT1 A 0 A_PlaySound("VassagoFlame/BurnSound")
		VFLM I 2 Bright A_Explode(Random(4,8),64,0)
		VFLM JK 2 Bright
		VFLM L 2 Bright A_Explode(Random(4,8),64,0)
		VFLM MNOPQ 2 Bright A_FadeOut(0.1)
		Stop
	}
}

Actor 64VassagoFlame
{
Scale 0.3
Height 8
Radius 6
Damage (4)
Speed 35
Gravity 1.0
Alpha 1.0
RenderStyle Add
