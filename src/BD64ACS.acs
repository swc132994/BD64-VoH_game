script "BD64Respawn" Respawn NET
{
	Thing_ChangeTID(0,6666 + PlayerNumber()); //assigns player a TID on map start & respawn
	SetInventory("HudSwitch",GetUserCVar(PlayerNumber(),"HUDSwitchCvar")); //HUD to Doom Style
	SetInventory("NoReloading",GetCvar("NoReloadCvar")); //no reloading mode for tactical & modern class
	SetInventory("AltLaserSkin",GetCvar("AlternativeLaserSkinCvar"));

	//classic weapons mode for tactical and modern classes
	SetInventory("ClassicChaingunToken",GetCvar("ClassicChaingunCvar"));
	
	if (GetCvar("FlashlightStartCvar"))
	{
		GiveInventory("FlashLightPickup",1);
	}

	Delay(1);
}

#libdefine SKILL_SURVIVAL 6
#libdefine SKILL_SURVIVAL_REALISM 7
#libdefine SKILL_HARD_PLUS 33

Script "BD64Initilize" Enter
{
	if(GameType() == GAME_TITLE_MAP) terminate;

	if(GameType() == GAME_SINGLE_PLAYER)
	{
		sethudsize(160,90,TRUE);
		setfont("BLASCR");
		HudMessageBold(s:"a"; HUDMSG_FADEOUT,1,CR_BLACK,0.1,0.1,0.1,1.0);
	}

	ACS_NamedExecuteAlways("BD64Respawn",0);
	CreateTranslation(2666,0:255=%[0,0,0]:[0.94,0.97,1.00]);

	int pc = GetPlayerInfo(PlayerNumber(),PLAYERINFO_PLAYERCLASS);
	if (pc == 1 || pc == 2)
	{

	}
	else
	{
		TakeInventory("Stamina",100);
	}

	if(GetCvar("WeaponsWarmUpCvar") == 0) //first select animation
	{
		TakeInventory("StartWeapon",1);
		TakeInventory("NeverSelectedPistol",1);
		TakeInventory("NeverSelectedRifle",1);
		TakeInventory("NeverSelectedShotgun",1);
		TakeInventory("NeverSelectedSSG",1);
		TakeInventory("NeverSelectedSMG",1);
		TakeInventory("NeverSelectedRL",1);
		TakeInventory("NeverSelectedPlasma",1);
		TakeInventory("NeverSelectedGauss",1);
	}

	//Watch Me Die+ (Zandronum emulation)
	if(GameSkill() == SKILL_HARD_PLUS && IsZandronum())
	{
		if(GameType() == GAME_NET_COOPERATIVE) terminate;
		else
		{
			ConsoleCommand("netgame 1");
			Log(l:"FO_TAG_HARDER_RELOAD_MESSAGE");
			ChangeLevel(StrParam(n:PRINTNAME_LEVEL),0,CHANGELEVEL_NOINTERMISSION,-1);
		}
	}

	//survival mode
	if(GameSkill() == SKILL_SURVIVAL || GameSkill() == SKILL_SURVIVAL_REALISM)
	{
		if(PlayerClass(PlayerNumber()) == 0)
			GiveInventory("64PortableFirstAidKit",1);
		else
			GiveInventory("64PortableFirstAidKitTactical",1);
	}

	//map checkers
	SetInventory("VmapCheck",GetCvar("VMapCheckCvar")); //vanilla final outpost & absolution tc maps
	SetInventory("TCMapCheck",GetCvar("TCMapCheckCvar"));
}

script "IceDeathTranslateACS" (void)
{
	Thing_SetTranslation(0,2666);
	SetResultValue(1);
}

Script "PlayerDeathScript" Death
{
	flashlightOn[PlayerNumber()] = 0;
	Delay(1);
	TakeInventory("FlashLightPickup",1);
}

script "DM_SpawnACS" (void)
{
	int isDM = (GetCVar("deathmatch") == 1);
	int isCoopRespawn = (GetCVar("sv_itemrespawn") == 1);

	if (isDM || isCoopRespawn)
	{
		SetResultValue(1);
	}
	else
	{
		SetResultValue(0);
	}
}

script "GoreCleanerACS" (void) NET CLIENTSIDE
{
	if (GameType() == GAME_NET_DEATHMATCH || GetUserCVar(ConsolePlayerNumber(),"GoreCleanerCvar") == 1)
	{
		SetResultValue(1);
	}
	else
	{
		SetResultValue(0);
	}
}

script "Zandro_Check" OPEN
{
	if(IsZandronum())
	{
		ConsoleCommand("compat_clientssendfullbuttoninfo 1");
	}
}

script "HaloDisabledACS" (void) NET CLIENTSIDE
{
	int mode = GetUserCVar(ConsolePlayerNumber(),"LightFogCvar");
	SetResultValue(mode == 1 || mode == 2);
}

script "LightFogDisabledACS" (void) NET CLIENTSIDE
{
	int mode = GetUserCVar(ConsolePlayerNumber(),"LightFogCvar");
	SetResultValue(mode == 1 || mode == 3);
}

script "RLauncherSwitchACS" (int currentIsClassic)
{
	int SwitchClassic = GetCVar("ClassicRLCvar");

	if (!currentIsClassic && SwitchClassic)	//from tactical to classic
	{
		GiveInventory("64ClassicRocketLauncherTactical",1);
		SetWeapon("64ClassicRocketLauncherTactical");
		TakeInventory("64RocketLauncherTactical",1);
		SetResultValue(1);
	}
	else if (currentIsClassic && !SwitchClassic) //from classic to tactical
	{
		int ammoCount = CheckInventory("RocketAmmo");
		GiveInventory("64RocketLauncherTactical",1);
		SetInventory("RocketAmmo",ammoCount);
		SetWeapon("64RocketLauncherTactical");
		TakeInventory("64ClassicRocketLauncherTactical",1);
		SetResultValue(1);
	}
	else
	{
		SetResultValue(0);
	}
}

script "ChainsawSwitchACS" (int currentIsClassic)
{
	int SwitchClassic = GetCVar("ClassicChainsawCvar");

	if (!currentIsClassic && SwitchClassic)	//from tactical to classic
	{
		GiveInventory("64ChainsawTactical_Classic",1);
		SetWeapon("64ChainsawTactical_Classic");
		TakeInventory("64ChainsawTactical",1);
		SetResultValue(1);
	}
	else if (currentIsClassic && !SwitchClassic)	//from classic to tactical
	{
		int FuelCount = CheckInventory("SawGas");
		GiveInventory("64ChainsawTactical",1);
		SetInventory("SawGas",FuelCount);
		SetWeapon("64ChainsawTactical");
		TakeInventory("64ChainsawTactical_Classic",1);
		SetResultValue(1);
	}
	else
	{
		SetResultValue(0);
	}
}

script "BerserkSwitchFistsACS" (void) NET
{
	if(GetUserCVar(PlayerNumber(),"BerserkSwitchFistsCvar") == true)
	{
		if(CheckInventory("IsTacticalClass") || CheckInventory("IsModern"))
		{
			SetWeapon("64FistTactical");
		}
		else
		{
			SetWeapon("64Fist");
		}
	}
}

script "TUnmakerChecker" (void) NET
{
	int highestResult = 1;

	for (int p = 0; p < 64; p++)
	{
		if (!PlayerInGame(p)) continue;

		int tid = 6666 + p;

		if (CheckActorInventory(tid,"unmakerTactical") || CheckActorInventory(tid,"64RuinerTactical"))
		{
			int currentResult = 2;

			if ((CheckActorInventory(tid,"WpnPower1Icon") && CheckActorInventory(tid,"WpnPower2Icon") && CheckActorInventory(tid,"WpnPower3Icon"))
			|| CheckActorInventory(tid,"WpnPower4Icon") || CheckActorInventory(tid,"WpnPower5Icon"))
			{
				currentResult = 3;
			}

			if (currentResult > highestResult)
			{
				highestResult = currentResult;

				if (highestResult == 3) break;
			}
		}
	}
	SetResultValue(highestResult);
}

