//Random monster spawners
Actor BD64ZombieManReplacer Replaces ZombieMan
{
//$Category Monsters
//$Title "Zombieman Spawner"
//$Arg0 What monster to spawn
//$Arg0Tooltip Select the monster to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Pistol Zombie"; 2 = "Force Zombie Marine"; }
Scale 0.8
MONSTER
-SOLID
-COUNTKILL
+NOTARGET
+NOBLOOD
	States
	{
	Spawn:
		PSSS B 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnZombieMan")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnZombieMarine")
		TNT1 A 0 A_JumpIf(CallACS("ZombiemanSpawnerACS") == 1,"SpawnZombieMan")
		TNT1 A 0 A_JumpIf(CallACS("ZombiemanSpawnerACS") == 2,"SpawnZombieMarine")
		TNT1 A 0 A_Jump(CallACS("MonstersSpawnPercentACS",1)*13,"SpawnZombieMarine")
	SpawnZombieMan:
		TNT1 A 1 A_SpawnItemEx("64ZombieMan",0,0,0,0,0,0,0,SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnZombieMarine:
		TNT1 A 1 A_SpawnItemEx("64ZombieMarine",0,0,0,0,0,0,0,SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

