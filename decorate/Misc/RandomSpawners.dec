//Weapon replacements
Actor BD64ChaingunReplacer Replaces Chaingun
{
//$Category Weapons
//$Title "Chaingun Spawner"
//$Arg0 What weapon to spawn
//$Arg0Tooltip Select the weapon to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Chaingun"; 2 = "Force Rifle"; 3 = "Force SMG"; }
Scale 0.82
	States
	{
	Spawn:
		MGUN A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnChaingun")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnRifle")
//		TNT1 A 0 A_Jumpif(args[0] == 3,"SpawnSMG")
		TNT1 A 0 A_JumpIf(CallACS("ChaingunSpawnerACS") == 1,"SpawnChaingun")
		TNT1 A 0 A_JumpIf(CallACS("ChaingunSpawnerACS") == 2,"SpawnRifle")
		TNT1 A 0 A_JumpIf(CallACS("ChaingunSpawnerACS") == 3,"SpawnSMG")
		TNT1 A 0 A_Jump(85,"SpawnSMG")//33%
		TNT1 A 0 A_Jump(85,"SpawnRifle")//33%
	SpawnChaingun:
		TNT1 A 1 A_SpawnItemEx("ChaingunSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnRifle:
		TNT1 A 1 A_SpawnItemEx("RifleSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnSMG:
		TNT1 A 1 A_SpawnItemEx("SMGSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

Actor BD64PlasmaRifleReplacer Replaces Plasmarifle	//Option to replace plasma rifle with gauss cannon
{
//$Category Weapons
//$Title "Plasma Rifle Spawner"
//$Arg0 What weapon to spawn
//$Arg0Tooltip Select the weapon to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Plasma Rifle"; 2 = "Force Gauss Cannon"; }
Scale 0.82
	States
	{
	Spawn:
		PLAS A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnPlasmaRifle")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnGaussCannon")
		TNT1 A 0 A_JumpIf(CallACS("PlasmaRifleSpawnerACS") == 1,"SpawnPlasmaRifle")
		TNT1 A 0 A_JumpIf(CallACS("PlasmaRifleSpawnerACS") == 2,"SpawnGaussCannon")
		TNT1 A 0 A_Jump(64,"SpawnGaussCannon")//25%
	SpawnPlasmaRifle:
		TNT1 A 1 A_SpawnItemEx("PlasmaRifleSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnGaussCannon:
		TNT1 A 1 A_SpawnItemEx("GaussCannonSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

Actor BD64BFGReplacer Replaces BFG9000	//Option to replace BFG with unmaker or lasergun
{
//$Category Weapons
//$Title "BFG9000 Spawner"
//$Arg0 What weapon to spawn
//$Arg0Tooltip Select the weapon to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force BFG9000"; 2 = "Force Unmaker"; 3 = "Force Laser gun"; }
Scale 0.9
	States
	{
	Spawn:
		BFUG A 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnBFG9000")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnUnmaker")
//		TNT1 A 0 A_Jumpif(args[0] == 3,"SpawnLasergun")
		TNT1 A 0 A_JumpIf(CallACS("BFGSpawnerACS") == 1,"SpawnBFG9000")
		TNT1 A 0 A_JumpIf(CallACS("BFGSpawnerACS") == 2,"SpawnUnmaker")
		TNT1 A 0 A_JumpIf(CallACS("BFGSpawnerACS") == 3,"SpawnLasergun")
		TNT1 A 0 A_Jump(64,"SpawnLasergun")//25%
		TNT1 A 0 A_Jump(64,"SpawnUnmaker")//25%
	SpawnBFG9000:
		TNT1 A 1 A_SpawnItemEx("BFG9000Spawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnUnmaker:
		TNT1 A 1 A_SpawnItemEx("UnmakerSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnLasergun:
		TNT1 A 1 A_SpawnItemEx("LasergunSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

