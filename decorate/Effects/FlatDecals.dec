ACTOR DetectFloorBullet
{
scale 0.4
radius 2
height 2
Gravity 1.0
Mass 5
Alpha 0.9
Renderstyle Translucent
+NOBLOCKMAP
+NOTELEPORT
+CLIENTSIDEONLY
+MOVEWITHSECTOR
+THRUACTORS
+MISSILE
+BOUNCEONFLOORS
BounceFactor 0.01
BounceCount 2
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(CallACS("FlatDecalACS")==0,"Off")	
		TNT1 A 0 A_JumpIf(waterlevel > 1,"Off")
		TNT1 A 0 ThrustThingZ(0,1,0,0)
		TNT1 A 5
		Stop
	Death:
		XXX1 A 2000
		XXX1 A 2 A_FadeOut(0.02)
		Wait
	Off:
		TNT1 A 1
		Stop
	}
}

ACTOR DetectCeilBullet
{
scale 0.4
radius 2
height 2
Mass 5
Alpha 0.9
Renderstyle Translucent
+NOBLOCKMAP
+NOTELEPORT
+CLIENTSIDEONLY
+MOVEWITHSECTOR
+THRUACTORS
+MISSILE
+NOGRAVITY
+SKYEXPLODE
-EXPLODEONWATER
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(CallACS("FlatDecalACS")==0,"Off")
		TNT1 A 0 A_JumpIf(waterlevel > 1,"Off")
		TNT1 A 0 ThrustThingZ(0,5,0,0)
		TNT1 A 6
		Stop
	Death:
		XXX1 A 2000
		XXX1 A 2 A_FadeOut(0.005)
		Wait
	Death.Sky:
	Off:
		TNT1 A 1
		Stop
	}
}

ACTOR DetectFloorCraterNoSplashes : DetectFloorBullet
{
scale 3.4
Alpha 0.9
Renderstyle Shaded
StencilColor "Black"
}

