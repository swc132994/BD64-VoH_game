//BLOOD SPOT ACTORS
ACTOR Brutal_BloodSpot	//modelled
{
Scale 0.5
radius 2
height 2
Gravity 1.0
Mass 5
+NOBLOCKMAP
+DONTSPLASH
+CORPSE
+NOTELEPORT
+CLIENTSIDEONLY
+MOVEWITHSECTOR
+THRUACTORS
+MISSILE
+BOUNCEONFLOORS
BounceFactor 0.01
BounceCount 2
	states
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(waterlevel > 1,"Splash")
		TNT1 A 0 ThrustThingZ(0,1,0,0)
		TNT1 A 5
		Stop
	Death:
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_ChangeFlag("MISSILE",FALSE)
		TNT1 A 0 A_Jump(256,1,2,3,4)	//Random frame A B C D
		BPDL A 0
		Goto Rest
		BPDL B 0
		Goto Rest
		BPDL C 0
		Goto Rest
		BPDL D 0
		Goto Rest
	Rest:
		"####" "#" 800
		"####" "#" 0 A_JumpIf(CallACS("GoreCleanerACS"),"Fade")
		Loop
	Fade:
		"####" "#" 3 A_FadeOut(0.1)
		Wait
	Splash:
		TNT1 A 1
		stop
	}
}

