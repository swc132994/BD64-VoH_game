//Prop replacements
Actor 64DeadMarineReplacer replaces DeadMarine
{
//$Category Decoration
//$Title "Dead Marine Spawner"
//$Arg0 What decoration/monster to spawn
//$Arg0Tooltip Select the decoration/monster to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Dead player"; 2 = "Force The Thing"; }
Scale 0.8
	States
	{
	Spawn:
		PLAY M 0
//		TNT1 A 0 A_Jumpif(args[0] == 1,"SpawnDeadMarine")
//		TNT1 A 0 A_Jumpif(args[0] == 2,"SpawnThing")
		TNT1 A 0 A_JumpIf(CallACS("ThingRandomACS") == 0,"SpawnDeadMarine")
		TNT1 A 0 A_Jump(26,"SpawnThing")//10%
	SpawnDeadMarine:
		TNT1 A 0 A_SpawnItemEx("64DeadMarine",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		TNT1 A 1 A_SpawnItemex("64TheHorde_Spawner")
		Stop
	SpawnThing:
		TNT1 A 1 A_SpawnItemEx("64Thing",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

