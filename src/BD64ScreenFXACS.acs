//Red Blood
script 580 (void) CLIENTSIDE
{
	if (GetCvar("bd64_ScreenFX") == 1)
	{
		SetHudSize(400,250,1);
		int id = 580;

		delay(1);
		setfont("RBLD1");  hudmessage(s:"A"; HUDMSG_PLAIN,id,CR_UNTRANSLATED,63.1,61.1,0.15);
		delay(4);
		setfont("RBLD2");  hudmessage(s:"A"; HUDMSG_PLAIN,id,CR_UNTRANSLATED,63.1,61.1,0.15);
		delay(4);
