ACTOR ExplosionParticleHeavy
{
Scale 0.06
Speed 5
Radius 1
Height 1
Gravity 0.5
RenderStyle Add
BounceType "Doom"
BounceFactor 0.01
BounceCount 1
+MISSILE
+NOBLOCKMAP
+FORCEXYBILLBOARD
+CLIENTSIDEONLY
+DONTSPLASH
+THRUACTORS
	States
	{
	Spawn:
		SPRK O 8 Bright NoDelay A_JumpIf(waterlevel > 1,"Splash")
	Death:
		TNT1 A 0 A_JumpIf(waterlevel > 1,"Splash")
		SPRK O 1 Bright A_FadeOut(0.03)
		Loop
	Splash:
		TNT1 A 1
		Stop
	}
}

ACTOR ExplosionParticleHeavySmall : ExplosionParticleHeavy
{
Scale 0.04
}

