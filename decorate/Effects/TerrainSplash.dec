//WATER
Actor LiquidParticleX
{
Scale 2.0
Height 1
Radius 1
Speed 7
Mass 0
Gravity 0.5
Alpha 0.4
RenderStyle Add
BounceFactor 0.1
+MISSILE
-NOGRAVITY
+DONTSPLASH
+FORCEXYBILLBOARD
+THRUACTORS
+NOBLOCKMAP
+CLIENTSIDEONLY
+NOTELEPORT
	States
	{
	Spawn:
		TNT1 A 1
		Goto Stand
	Stand:
		LIQU ABCDDDDDDDDDDDDDDDDDDD 4
		Stop
	Death:
		TNT1 A 1
		TNT1 AAA 0 A_SpawnItemEx("WaterParticleX",random(-5,5),random(-5,5),2,frandom(-2,2),frandom(-2,2),frandom(2,6))
		TNT1 A 1
		Stop
	}
}

Actor WaterParticleXSpawner
{
scale 0.15
radius 2
height 0
speed 40
alpha 0.9
renderstyle ADD
+MISSILE
+NOGRAVITY
+FORCEXYBILLBOARD
+THRUACTORS
+NOBLOCKMAP
+NOTELEPORT
+CLIENTSIDEONLY
	states
	{
	Spawn:
		TNT1 AAAAA 1 A_JumpIf(waterlevel < 1,"SurfaceSpawn")
		Stop
	SurfaceSpawn:
		TNT1 AAAAA 0 A_SpawnItemEx("SpawnLiquidParticleX")
		TNT1 AAAA 1 A_SpawnItemEx("SpawnLiquidParticleX")
		Stop
	Death:
		TNT1 A 1
		Stop
	XDeath:
		TNT1 A 1
		Stop
	}
}

Actor SpawnLiquidParticleX
{
+NOCLIP
+NOGRAVITY
+NOTELEPORT
+CLIENTSIDEONLY
	states
	{
	Spawn:
		TNT1 AAAAAA 0 NoDelay A_SpawnItemEx("LiquidParticleX",0,0,0,frandom(-4,4),frandom(-4,4),frandom(1,6))
		TNT1 A 1
		Stop
	}
}

Actor BUBULZ
{
Scale 0.5
Height 0
Radius 0
Mass 0
Speed 2
RenderStyle Add
BounceType "Doom"
+MISSILE
+NOBLOCKMAP
+THRUACTORS
+NOGRAVITY
+DONTSPLASH
+FORCEXYBILLBOARD
+CLIENTSIDEONLY
+NOTELEPORT
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"Spawn1","Spawn2")
	Spawn1:
		TNT1 A 0 ThrustThingZ(0,2,0,1)
		BUBL AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_JumpIf(waterlevel < 1,"Death")
		Stop
	Spawn2:
		TNT1 A 0 ThrustThingZ(0,2,0,1)
		BUBL BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 Bright A_JumpIf(waterlevel < 1,"Death")
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}

Actor EXPLOSIONBUBULZ : BUBULZ
{
Speed 10
+NOTELEPORT
	States
	{
	Spawn:
		BUBL A 10
		TNT1 A 0 A_Jump(256,"Spawn1","Spawn2")
	Spawn1:
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_JumpIf(waterlevel < 1,"Death")
		Stop
	Spawn2:
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1,"Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 Bright A_JumpIf(waterlevel < 1,"Death")
		Stop
	Death:
		TNT1 A 1
		Stop
	}
}

