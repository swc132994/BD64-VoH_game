	States
	{
	Spawn:
		SPRK A 1 Bright A_FadeOut(0.1)
		Loop
	}
}

ACTOR 64Spark
{
Scale 0.02
Height 1
Radius 2
Speed 1.0
Mass 0
Gravity 0.125
BounceType "Doom"
BounceFactor 0.2
RenderStyle Add
+MISSILE
+NOBLOCKMAP
+CLIENTSIDEONLY
+THRUACTORS
	States
	{
	Spawn:
		SPRK A 0 NoDelay A_ScaleVelocity(frandom(0.20,2.5))
	Fly:
		SPRK A 2 Bright A_FadeOut(0.02)
		Loop
	Death:
		SPRK A 1 Bright A_FadeOut(0.1)
		Loop
	}
}