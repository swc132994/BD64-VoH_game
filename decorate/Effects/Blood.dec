	{
	Spawn:
		TNT1 A 3 NoDelay ThrustThingZ(0,300,0,1)
		Stop
	Death:
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_SpawnItemEx("DrippingBloodLeavesSmallPool")
		TNT1 A 0 A_SpawnItemEx("CeilBloodTinyBloodSpawner")
		TNT1 A 0 A_Jump(256,1,2,3,4)	//Random frame A B C D
		BPDL A 0
		Goto Rest
		BPDL B 0
		Goto Rest
		BPDL C 0
		Goto Rest
		BPDL D 0
		Goto Rest
	Rest:
		BPDL "#" 1050
		BPDL "#" 3 A_FadeOut(0.002)
		wait
	Death.Sky:
		TNT1 A 1
		Stop
	}
}

