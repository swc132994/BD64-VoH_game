{
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_CustomMissile("EmptyBrass",0,0,random(-80,-100),2,random(40,60))
		TNT1 A 1 A_CustomMissile("ChainBeltLink",0,0,random(-80,-100),2,random(40,80))
		Stop
	}
}

