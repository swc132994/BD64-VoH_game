Actor 64Soulsphere : CustomInventory// Replaces Soulsphere (RandomSpawners.dec)
{
Scale 0.7
+COUNTITEM
+INVENTORY.ALWAYSPICKUP
Inventory.PickupMessage "$FO_GOTSUPER"
Inventory.PickupSound "misc/p_pkup"
Inventory.PickupAnnouncerEntry "soulsphere"
Tag "$FO_TAG_SUPER"
	States
	{
	Spawn:
		SOUL A 0 Bright Light("SOULSPHERE")
	ACSCheck:
		"####" "#" 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1,"ShowAlpha")
	ShowNormal:
		SOUL ABCDCB 6 Bright Light("SOULSPHERE")
		Goto ACSCheck
	ShowAlpha:
		2OUL ABCDCB 6 Bright Light("SOULSPHERE")
		Goto ACSCheck
	Pickup:
		TNT1 A 0 A_GiveInventory("SoulSphere",1)
		TNT1 A 0 A_TakeInventory("Stamina",0)
		Stop
	}
}

