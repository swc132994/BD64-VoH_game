ACTOR 50CaseSpawn
{
Speed 20
+NOBLOCKMAP
+NOINTERACTION
+NOCLIP
+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 1 NoDelay A_CustomMissile("EmptyBrass",0,0,random(-80,-100),2,random(40,60))
		Stop
	}
}

