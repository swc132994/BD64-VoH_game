ACTOR Brutal_FlyingBlood
{
game Doom
scale 0.5
speed 4
health 0
radius 6
height 12
Gravity 0.8
Mass 1
Decal "BrutalBloodSplat"
+MISSILE
+CLIENTSIDEONLY
+NOTELEPORT
+NOBLOCKMAP
+THRUACTORS
+BLOODLESSIMPACT
+FORCEXYBILLBOARD
+NODAMAGETHRUST
+MOVEWITHSECTOR
+CORPSE
+BOUNCEONFLOORS
+DONTSPLASH
BounceFactor 0.01
BounceCount 1
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(waterlevel > 1,"Splash")
		BLOD AB 2
		TNT1 A 0 A_Jump(256,1,2,3)	//Random frame C D E
		TNT1 C 0
		Goto SpawnLoop
		TNT1 D 0
		Goto SpawnLoop
		TNT1 E 0
		Goto SpawnLoop
	SpawnLoop:
		BLOD "#" 3 A_JumpIf(waterlevel > 1,"Splash")
		loop
	Splash:
		TNT1 A 1 A_SpawnItemEx("UnderBlood2",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION)
		stop
	Death:
		TNT1 A 0 A_PlaySound("blooddrop2",CHAN_BODY)
		TNT1 A 0 A_CheckCeiling("SpawnCeiling")
		TNT1 A 1 A_CheckFloor("SpawnFloor")
		Stop
	SpawnCeiling:
		TNT1 A 1 A_SpawnItemEx("CeilBloodSpot")
		Stop
	SpawnFloor:
		TNT1 A 1 A_SpawnItemEx("Brutal_BloodSpot")
		Stop
	}
}

