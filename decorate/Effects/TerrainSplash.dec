		Stop
	Death.CauseWaterSplash:
		TNT1 A 0 A_SpawnItemEx("LavaParticleXSpawner",0,0,0,frandom(-3,3),frandom(-3,3),frandom(4,8))
		TNT1 A 0 A_SpawnItemEx("GiantLavaRicochet")
		TNT1 A 0 A_PlaySound("world/lavasizzle",CHAN_BODY)
		TNT1 A 30
		Stop
	}
}