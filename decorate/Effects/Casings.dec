ACTOR EmptyBrass
{
Scale 0.2
Radius 2
Height 2
Speed 6
Mass 5
BounceSound "weapons/casing"
+MISSILE
+FORCEXYBILLBOARD
+NOBLOCKMAP
+NOTELEPORT
+MOVEWITHSECTOR
+CLIENTSIDEONLY
+THRUACTORS
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+DONTSPLASH
BounceCount 4
BounceFactor 0.3
	States
	{
	Spawn:
		CAS3 A 0 NoDelay A_Jump(128,2)
		"####" "#" 0 A_SetScale(0-ScaleX,ScaleY)		//FLIP IMAGE HORZ
	Bounce:
		"####" "#" 0 A_JumpIf(waterlevel > 1,"Splash")
		CAS3 FGHABCDE 3
		Loop
	Death:
		TNT1 A 0 A_Jump(256,"Rest1","Rest2","Rest3")
		Goto Rest1
	Rest1:
		CAS3 I 350
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	Rest2:
		CAS3 J 350
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	Rest3:
		CAS3 K 350
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	Splash:
		"####" "#" 0 A_Stop
		"####" "#" 0 A_Changeflag("BOUNCEONWALLS",FALSE)
		"####" "#" 0 A_Changeflag("BOUNCEONFLOORS",FALSE)
		"####" "#" 0 A_Changeflag("ALLOWBOUNCEONACTORS",FALSE)
		"####" "#" 0 A_Changeflag("BOUNCEAUTOOFF",FALSE)
	SplashHold:
		"####" "#" 12
		"####" "#" 0 ThrustThingZ(0,7,1,0)
		"####" "#" 12
		"####" "#" 0 ThrustThingZ(0,7,1,0)
		"####" "#" 12
		"####" "#" 0 ThrustThingZ(0,7,1,0)
		"####" "#" 12
		"####" "#" 0 A_SpawnItemEx("BUBULZ")
		"####" "#" 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	Stopping:
	Crush:
		TNT1 A 1
		Stop
	}
}

ACTOR ChainBeltLink : EmptyBrass
{
Scale 0.25
Speed 4
	States
	{
	Spawn:
		CLIN A 0 NoDelay A_Jump(128,2)
		"####" "#" 0 A_SetScale(0-ScaleX,ScaleY)		//FLIP IMAGE HORZ
	Bounce:
		"####" "#" 0 A_JumpIf(waterlevel > 1,"Splash")
		CLIN ABCDEFGH 3
		Loop
	Death:
		TNT1 A 0 A_Jump(256,"Rest1","Rest2")
		Goto Rest1
	Rest1:
		CLIN B 350
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	Rest2:
		CLIN F 350
		TNT1 A 0 A_JumpIf(CallACS("GoreCleanerACS"),"Stopping")
		Loop
	}
}

