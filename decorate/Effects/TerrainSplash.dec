// BUBBLES
Actor BUBULZ
{
Scale 0.5
Height 0
Radius 0
Mass 0
Speed 2
RenderStyle Add
+MISSILE
+NOBLOCKMAP
+THRUACTORS
+NOGRAVITY
+DONTSPLASH
+FORCEXYBILLBOARD
+CLIENTSIDEONLY
+NOTELEPORT
ReactionTime 35
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ThrustThingZ(0,3,0,1)
	Fade:
		TNT1 A 0 A_JumpIf(waterlevel < 1,"Death")	
		BUBL A 3 Bright A_FadeOut(0.07)
		TNT1 A 0 A_Countdown
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}

Actor EXPLOSIONBUBULZ : BUBULZ
{
	Speed 10
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ThrustThingZ(0,6,0,1)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BUBULZ",random(-4,4),random(-4,4),random(2,16),frandom(-1,1),frandom(-1,1),frandom(1,4),0,SXF_CLIENTSIDE,96)
		TNT1 A 1
		Stop
	}
}

//BASE PARTICLE SPRITES
Actor WaterParticleX
{
Scale 1.0
Radius 2
Height 2
Gravity 0.5
Alpha 0.6
RenderStyle Add
-NOGRAVITY
+MISSILE
+NOBLOCKMAP
+DONTSPLASH
+FORCEXYBILLBOARD
+THRUACTORS
+CLIENTSIDEONLY
+NOTELEPORT
	States
	{
	Spawn:
		WSPH ABCDDDDDDDD 3
		Stop
	Death:
		TNT1 A 1
		Stop
	}
}

Actor LiquidParticleX : WaterParticleX
{
Scale 1.8
	States
	{
	Spawn:
		LIQU ABCDDDDDDDDDDDDDDD 3
		Stop
	}
}

//WATER SPLASHES
ACTOR GiantWaterRicochet : RicoChet
{
XScale 3.0
YScale 2.0
Alpha 0.9
RenderStyle Add
+NOBLOCKMAP
+THRUACTORS
+NOGRAVITY
+CLIENTSIDEONLY
	States
	{
	Spawn:
		GSPL ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
		Stop
	}
}

Actor WaterSplashBase2
{
Scale 1.1
Radius 1
Height 1
Mass 0x7FFFFFFF
Health 100
Alpha 0.6
DamageFactor "CauseWaterSplash",99.0
DamageType "CauseObjectsToSplash"
+DONTSPLASH
+NOGRAVITY
+THRUACTORS
+SHOOTABLE
+NOBLOOD
+BLOODLESSIMPACT
+NODAMAGETHRUST
	States
	{
	Spawn:
		TNT1 A 3 NoDelay ACS_NamedExecuteAlways("LiquidSplashCvarACS")
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("WaterParticleX",random(-5,5),random(-5,5),2,frandom(-2.5,2.5),frandom(-2.5,2.5),frandom(2,5),0,SXF_CLIENTSIDE)
		TNT1 A 0 A_Explode(2,6)
		TNT1 AA 6
		TNT1 A 0 A_UnSetShootable
		TNT1 AA 6
		Stop
	Death.CauseWaterSplash:
		TNT1 A 0 A_SpawnItemEx("GiantWaterRicochet")
		TNT1 A 0 A_PlaySound("bigspl1",CHAN_BODY)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("WaterParticleX",random(-10,10),random(-10,10),4,frandom(-5,5),frandom(-5,5),frandom(7,14),0,SXF_CLIENTSIDE)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LiquidParticleX",random(-8,8),random(-8,8),4,frandom(-4,4),frandom(-4,4),frandom(6,12),0,SXF_CLIENTSIDE)
		
		TNT1 A 30
		Stop
	NoSplash:
		TNT1 A 1
		Stop
	}
}

Actor LiquidExplosionEffectSpawner
{
Radius 2
Height 2
DamageType "CauseWaterSplash"
+NOBLOCKMAP
+THRUACTORS
+DONTSPLASH
+MISSILE
+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 3 NoDelay ACS_NamedExecuteAlways("LiquidSplashCvarACS")
		TNT1 A 1 A_Explode(3,9)
		Stop
	NoSplash:
		TNT1 A 1
		Stop
	}
}

