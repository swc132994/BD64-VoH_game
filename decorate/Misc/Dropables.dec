//DROPPED WEAPON PROJECTILES
Actor DroppedShotgun
{
XScale 0.7
YScale 0.4
Speed 4
Radius 16
Height 4
Gravity 0.9
+MISSILE
+THRUACTORS
+NOTELEPORT
+NOBLOCKMAP
+FORCEXYBILLBOARD
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(128,"SpinReverse")
	SpinForward:
		TRII ABCDEFGH 4
		Loop
	SpinReverse:
		TNT1 A 0 A_SetScale(-ScaleX,ScaleY)
	SpinReverseLoop:
		TRII GFEDCBA 4
		Loop
	Death:
		TNT1 A 0 A_DropItem("64ShotgunTACTICAL")
		TNT1 A 1 A_DropItem("64Shotgun")
		Stop
	}
}

ACTOR DroppedSSG : DroppedShotgun
{
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(128,"SpinReverse")
	SpinForward:
		TRI1 ABCDEFGH 4
		Loop
	SpinReverse:
		TNT1 A 0 A_SetScale(-ScaleX,ScaleY)
	SpinReverseLoop:
		TRI1 GFEDCBA 4
		Loop
	Death:
		TNT1 A 0 A_DropItem("64SuperShotgunTACTICAL")
		TNT1 A 1 A_DropItem("64SuperShotgun")
		Stop
	}
}

