ACTOR TeleportationFog : TeleportFog Replaces TeleportFog
{
Scale 1.25
Radius 0
Height 0
Renderstyle Add
+NOINTERACTION
+NOGRAVITY
	States
	{
	Spawn:
		TNT1 A 0 NoDelay Radius_Quake(3,3,0,10,0)
		TNT1 A 0 A_PlaySound("misc/teleport",CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("BurningPentagram",0,0,5)
		TPFG HGFEDCBA 1 Bright
		TNT1 A 0 A_CheckSight("QuietDeath")
		TNT1 AAAAA 0 A_CustomMissile("ExplosionParticleGreenHeavySmall",10,0,random(0,360),2,random(20,50))
		TNT1 AAAAA 0 A_CustomMissile("ExplosionParticleGreenVeryFast",10,0,random(0,360),2,random(20,40))
	QuietDeath:
		TPFG ABCDEFG 1 Bright
		Stop
	Death:
		TNT1 A 1
		Stop
	}
}

ACTOR BurningPentagram
{
XScale 0.25
YScale 0.025
Gravity 10
Radius 1
Height 1
Alpha 0
RenderStyle Add
+NOBLOCKMAP
+NOTELEPORT
+CLIENTSIDEONLY
+MOVEWITHSECTOR
+THRUACTORS
+MISSILE
+BOUNCEONFLOORS
+DONTSPLASH
-NOGRAVITY
BounceFactor 0.01
BounceCount 1
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(waterlevel > 1,"Off")
		TNT1 A 3
		Stop
	Death:
		PNTG AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright Light("BETABALL_X4") A_FadeIn(0.03)
		TNT1 A 0 A_SetTranslucent(1.0,0)
		PNTG B 2 A_FadeOut(0.01)
		Wait
	Off:
		TNT1 A 1
		Stop
	}
}

ACTOR TeleportationFogObject : TeleportationFog
{
Scale 1
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("misc/teleport",CHAN_ITEM)
		IFOG ABCDEDCBA 2 Bright
		Stop
	}
}