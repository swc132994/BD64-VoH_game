		stop
	SpawnImpaler:
		TNT1 A -1 A_SpawnItemEx("64Impaler",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERAMBUSHFLAG|SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		stop
	}
