Actor 64Berserk : Berserk// Replaces Berserk (RandomSpawners.dec)
{
Scale 0.82
Inventory.PickupMessage "$FO_GOTBERSERK"
Tag "$FO_TAG_BERSERK"
	States
	{
	Spawn:
		PSTR A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1,"ShowAlpha")
		TNT1 A 0 A_JumpIf(CallACS("CensoredHealingACS") == 1,"ShowCensored")
		TNT1 A 0 A_JumpIf(CallACS("CensoredHealingACS") == 2,"ShowBFGStyle")
	ShowNormal:
		PSTR A 35
		Goto ACSCheck
	ShowCensored:
		PSTR B 35
		Goto ACSCheck
	ShowBFGStyle:
		PSTR C 35
		Goto ACSCheck
	ShowAlpha:
		PSTR D 35
		Goto ACSCheck
	Pickup:
		TNT1 A 0 A_SetBlend("ff0000",0.75,70)
		TNT1 A 0 A_GiveInventory("PowerStrength")
		TNT1 A 0 HealThing(100,0)
		TNT1 A 0 ACS_NamedExecute("BerserkSwitchFistsACS")
		Stop
	}
}

