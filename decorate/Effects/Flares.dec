Actor LensFlareAlt : Flare_General
{
xScale 0.6
yScale 0.3
alpha 0.5
	states
	{
	Spawn:
		LENS A 5 Bright
		Stop
	}
}

Actor LensFlareAltLongOrangeCandle : LensFlareAlt
{
Alpha 0.5
ReactionTime 6
	states
	{
	Spawn:
		LEYS O 0 Bright
		TNT1 A 2 ACS_NamedExecuteAlways("LightAndFogChecker")
	Live:
		LEYS O 3 Bright A_SetScale(0.4,0.3)
		LEYZ O 1 Bright A_SetScale(0.2,0.1)
		LEYZ O 2 Bright A_SetScale(0.3,0.2)
		TNT1 A 0 A_CountDown
		Loop
	NoLight:
	Death:
		TNT1 A 3
		Stop
	}
}

