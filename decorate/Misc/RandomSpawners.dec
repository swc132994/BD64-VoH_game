{
//$Category Monsters
//$Title "Shotgunguy Spawner"
//$Arg0 What monster to spawn
//$Arg0Tooltip Select the monster to spawn.
//$Arg0Type 11
//$Arg0Enum { 0 = "Configurable by user (DEFAULT)"; 1 = "Force Sergeant"; 2 = "Force SSG Zombie"; 3 = "Force Brigadier general"; }
Scale 0.8
