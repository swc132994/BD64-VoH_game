Actor 64Stimpack : Stimpack Replaces Stimpack
{
Scale 0.82
Inventory.PickupMessage "$FO_GOTSTIM"
Tag "$FO_TAG_STIM"
	States
	{
	Spawn:
		STIM A 0
	ACSCheck:
		TNT1 A 0 A_JumpIf(CallACS("AlphaSpritesACS") == 1,"ShowAlpha")
		TNT1 A 0 A_JumpIf(CallACS("CensoredHealingACS") == 1,"ShowCensored")
		TNT1 A 0 A_JumpIf(CallACS("CensoredHealingACS") == 2,"ShowBFGStyle")
	ShowNormal:
		STIM A 35
		Goto ACSCheck
	ShowCensored:
		STIM B 35
		Goto ACSCheck
	ShowBFGStyle:
		STIM C 35
		Goto ACSCheck
	ShowAlpha:
		STIM D 35
		Goto ACSCheck
	}
}

