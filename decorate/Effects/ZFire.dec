ACTOR FlameTrails
{
Scale 0.5
Radius 1
Height 1
Speed 3
Damage 0
Gravity 0
Alpha 1
RenderStyle Add
DamageType "Flames"
+NOBLOCKMAP
+NOTELEPORT
+DONTSPLASH
+FORCEXYBILLBOARD
+CLIENTSIDEONLY
+NOINTERACTION
+NOCLIP
	States
	{
	Spawn:
		TNT1 A 2
		FRPR ABCDEFGH 3 Bright
		Stop
	}
}

